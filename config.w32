// Runtime CPUID selects SSSE3; no global SIMD compiler flag is needed.

ARG_ENABLE("fast-uuid", "Enable fast_uuid support", "no");

if (PHP_FAST_UUID != "no") {
    EXTENSION("fast_uuid", "fast_uuid.c", null,
        "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
    AC_DEFINE("HAVE_FAST_UUID", 1, "fast_uuid enabled");
    PHP_INSTALL_HEADERS("ext/fast_uuid", "php_fast_uuid.h");
}
