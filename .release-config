# fast_uuid release configuration, consumed by /release-ext.
# This file IS committed (structural metadata that travels with the repo).

# Required
extension: fast_uuid                  # from composer.json name
version_macro: PHP_FAST_UUID_VERSION  # from php_fast_uuid.h
version_file: php_fast_uuid.h
repo: iliaal/fast_uuid                # composer.json name; no git remote configured yet
# Release binaries are built per GA PHP version. 8.6 is supported and tested
# (see tests.yml) but not listed here until its GA, since pre-release Windows/
# release builds aren't published yet -- add PHP-8.6 when 8.6.0 ships.
build_matrix:
  - PHP-8.1
  - PHP-8.2
  - PHP-8.3
  - PHP-8.4
  - PHP-8.5
configure_base: "--enable-fast-uuid"

# Optional
asan_test: true                       # RFC byte-layout + RNG buffer code; verify under ASAN on release
windows_ci: true                      # .github/workflows/release-windows.yml (split pattern, fires on release:[published])
linux_prebuilt: true                  # .github/workflows/release-linux.yml: Linux glibc x86_64+arm64, macOS arm64
smoke_test: ""
