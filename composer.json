{
    "name": "iliaal/fast_uuid",
    "description": "Fast RFC 9562 UUID generation (v1/v2/v3/v4/v6/v7/v8 + nil/max) as a PHP C extension, with a ramsey/uuid-shaped object API and procedural fast-path functions.",
    "type": "php-ext",
    "license": "BSD-3-Clause",
    "keywords": ["uuid", "guid", "rfc9562", "rfc4122", "extension", "uuid7"],
    "authors": [
        {
            "name": "Ilia Alshanetsky",
            "email": "ilia@ilia.ws"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "php-ext": {
        "extension-name": "fast_uuid",
        "configure-options": [
            {
                "name": "enable-fast-uuid",
                "description": "Enable fast_uuid support",
                "needs-value": false
            }
        ],
        "support-zts": true,
        "support-nts": true,
        "download-url-method": [
            "pre-packaged-binary",
            "composer-default"
        ]
    }
}
